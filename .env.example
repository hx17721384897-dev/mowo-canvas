# Copy this file to .env.local only when the project introduces environment variables.
# Never place real secrets in this tracked example file.
# Browser-visible variables must use the NEXT_PUBLIC_ prefix and contain no secrets.

# Optional during local development. If omitted, user data defaults to
# the Windows Documents/MOWO Canvas Data directory.
MOWO_DATA_ROOT=

# Optional HTTP/HTTPS proxy used only by server-side platform downloaders.
# Example: http://127.0.0.1:10809
MOWO_HTTP_PROXY=

# Server-side DeepSeek development key. Put the real value only in .env.local.
DEEPSEEK_API_KEY=
